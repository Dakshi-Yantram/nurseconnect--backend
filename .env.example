# Copy to .env on the server and fill in. NEVER commit the real file.
APP_NAME=NurseConnect
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/nurseconnect
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@HOST:5432/nurseconnect
REDIS_URL=rediss://HOST:6379/0
CELERY_BROKER_URL=rediss://HOST:6379/1
CELERY_RESULT_BACKEND=rediss://HOST:6379/2

# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Must be false in production (the app refuses to start otherwise)
MOCK_EXTERNAL_PROVIDERS=false

# Exact frontend origin(s), comma-separated. No wildcard in production.
CORS_ORIGINS=https://app.nurseconnect.in
# Optional extra origin regex, e.g. ^https://nurseconnect-web\.YOURACCOUNT\.workers\.dev$
CORS_ORIGIN_REGEX=

# Proxies in front of the app that append to X-Forwarded-For (CloudFront -> app = 1)
TRUSTED_PROXY_HOPS=1
# Set true only if you still rely on app.seed to create tables on boot
RUN_SEED_ON_STARTUP=false
MAX_UPLOAD_MB=10
PUBLIC_API_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_WEBHOOK_SECRET=
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_WEBHOOK_SECRET=
INTERAKT_API_KEY=
INTERAKT_WEBHOOK_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
